// Server-only URL for the FastAPI backend. Not exposed to the browser.
BACKEND_URL=http://localhost:8000

// The frontend textarea enforces a hard cap of 50,000 characters to match
// the backend's MAX_SOURCE_CHARS default. Inputs above this limit are blocked
// in the UI; the backend still truncates (with a warning log) if called directly.
// MAX_SOURCE_CHARS=50000
